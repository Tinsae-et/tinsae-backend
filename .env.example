DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://tinsae:tinsae@db:5432/tinsae
CORS_ALLOWED_ORIGINS=http://localhost:3000
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_your_token_here
ENABLE_TELEGRAM_BOT_PROMPTS=False
PRODUCT_STALENESS_DAYS=30
CONFIRMATION_REQUEST_EXPIRY_HOURS=48
MYPRODUCTS_PAGE_SIZE=5
TELEGRAM_LINK_CODE_TTL_HOURS=24

# Auth / password reset. All optional — base.py has working defaults, and the
# console email backend prints reset links to the server log so the flow is
# testable with no SMTP anywhere.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Tinsae <no-reply@tinsae.et>
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT=10800
