DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://tinsae:tinsae@db:5432/tinsae
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Proxy hops in front of the app, for login throttling. 0 locally (nothing in
# front). Set to the real hop count in production — 1 behind a single Railway or
# nginx layer. Too high is as bad as too low: DRF then reads a client-controlled
# X-Forwarded-For entry and the per-IP login cap becomes bypassable.
NUM_PROXIES=0
# Seconds to hold a Postgres connection open between requests. 0 restores
# Django's connect-per-request default — set that behind a transaction-mode
# pooler (pgbouncer), which is mutually exclusive with persistent connections.
CONN_MAX_AGE=60
# Read only by prod settings, and empty there by default. Comma-separated and
# scheme-qualified: https://admin.tinsae.et,https://tinsae.et. Django rejects an
# unlisted cross-origin POST to the admin or any session-auth view once the site
# is behind HTTPS. The API itself is JWT and unaffected.
CSRF_TRUSTED_ORIGINS=
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_your_token_here
TELEGRAM_BOT_USERNAME=tinsae_bot
ENABLE_TELEGRAM_BOT_PROMPTS=False
TELEGRAM_MOCK_SEND=False
PRODUCT_STALENESS_DAYS=30
CONFIRMATION_REQUEST_EXPIRY_HOURS=48
CONFIRMATION_INTERVAL_DAYS=7
CONFIRMATION_HIDDEN_AFTER_DAYS=14
MYPRODUCTS_PAGE_SIZE=5
SEARCH_LOG_RETENTION_DAYS=180
TELEGRAM_LINK_CODE_TTL_HOURS=24

# Auth / password reset. All optional — base.py has working defaults, and the
# console email backend prints reset links to the server log so the flow is
# testable with no SMTP anywhere.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Tinsae <no-reply@tinsae.et>
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT=10800

# Celery & background tasks (default uses local redis container)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
